# =====================================================================
# TVU Canal 11 - Gestión Publicitaria (Proyecto 2, Grupo 13 SA)
# Copiar como .env y completar APP_KEY (php artisan key:generate) y DB_PASSWORD.
# Solo están las variables que el proyecto usa; lo demás toma el valor
# por defecto de Laravel.
# =====================================================================

# ----- Aplicación -----
APP_NAME="TVU Canal 11 - Gestion Publicitaria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# En el servidor: https://www.tecnoweb.org.bo/inf513/grupo13sa/proyecto2
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file

# ----- Base de datos: PostgreSQL de tecnoweb (la misma del Proyecto 1) -----
DB_CONNECTION=pgsql
DB_HOST=db.tecnoweb.org.bo
DB_PORT=5432
DB_DATABASE=db_grupo13sa
DB_USERNAME=grupo13sa
DB_PASSWORD=
# true en local (reutiliza la conexión porque la BD está lejos); false en el servidor
DB_PERSISTENT=false

# ----- Seguridad -----
# Costo de bcrypt para las contraseñas
BCRYPT_ROUNDS=12
# Duración del token de sesión de la API, en minutos
SANCTUM_EXPIRATION=480

# ----- Sesión, caché y colas -----
# En archivos y síncrono, para no crear tablas extra en la BD.
# No borrar: sin estas líneas Laravel 12 usaría tablas de la BD que no existen.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ----- Registros (storage/logs/laravel.log) -----
LOG_CHANNEL=stack
LOG_STACK=single
# En el servidor: error
LOG_LEVEL=debug

# ----- Monitoreo (scraping de YouTube) -----
# Solo en Windows: certificados raíz para HTTPS, p. ej. "C:/Program Files/Git/mingw64/etc/ssl/certs/ca-bundle.crt"
SCRAPING_CA_BUNDLE=
# Páginas de resultados por búsqueda (cada término hace 2 búsquedas)
SCRAPING_PAGINAS=2
